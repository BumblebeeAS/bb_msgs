# Goal
float32 x                   # Target x position (NED frame)
float32 y                   # Target y position (NED frame)
float32 z                   # Target z position (NED frame)
bool relative               # If true, x/y/z are offsets from current position
float32 x_threshold         # Position threshold in x (meters)
float32 y_threshold         # Position threshold in y (meters)
float32 z_threshold         # Position threshold in z (meters)
---
# Result
bool success                # Whether the goal was reached
float32 final_x             # Final x position
float32 final_y             # Final y position
float32 final_z             # Final z position
float32 time_elapsed        # Time taken to reach goal
string message              # Status message
---
# Feedback
float32 current_x           # Current x position
float32 current_y           # Current y position
float32 current_z           # Current z position
float32 distance_to_goal    # Distance remaining to goal
