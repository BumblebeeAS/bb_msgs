int8 DEPTH_MODE_DEPTH = 0
int8 DEPTH_MODE_ALTITUDE = 1
bool move_rel                # If true, forward/sidemove setpoints are offsets in the vehicle's yaw frame at request time (every waypoint, not chained); otherwise world frame
bool depth_rel               # If true, depth setpoints are offsets from the depth at request time. Resulting depth is clamped to >= 0
bool heading_rel             # If true, heading setpoints are offsets from the heading at request time. Roll and pitch are always absolute. Ignored when specified_heading is false
int8 depth_ctrl
bool specified_heading true  # If false, heading setpoints and heading_rel are ignored: the vehicle turns to face each waypoint before translating to it
string planner ""              # Planner to use to transform poses
float32[] roll_setpoints
float32[] pitch_setpoints
float32[] heading_setpoints
float32[] depth_setpoints
float32[] altitude_setpoints
float32[] forward_setpoints
float32[] sidemove_setpoints
float32 forward_tolerance
float32 sidemove_tolerance
float32 heading_tolerance
float32 depth_tolerance
int32 max_correction_time 30 # max time (s) for feedback to correct position error before goal returns, after feedforward has completed traj
---
uint8 STATUS_SUCCESS = 0
uint8 STATUS_FAILURE = 1
uint8 STATUS_ABORTED = 2
float32 roll_final
float32 pitch_final
float32 heading_final
float32 depth_final
float32 altitude_final
float32 forward_final
float32 sidemove_final
uint8 status
string trajectory_id # latest trajectory id
---
float32 roll_error
float32 pitch_error
float32 heading_error
float32 depth_error
float32 altitude_error
float32 forward_error
float32 sidemove_error
float32 progress                # 0 to n for trajectory progress (n = number of waypoints), -1 for error
float32 overall_progress         # 0 to 1 for trajectory progress
uint8   risk_factor     # Risk (Slack) Factor in percentage. On a scale of 0% to 100%, representing norminal to "We are screwed"
string  trajectory_id   # current trajectory id
