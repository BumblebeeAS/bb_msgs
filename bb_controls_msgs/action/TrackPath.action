# Goal
geometry_msgs/PoseStamped goal_pose
string anchor_frame_name "base_link"
bool last_goal_anchor_only false

# Retry & Replanning Logic
int32 max_replans 3

# Locomotion Passthrough parameters
bool specified_heading true
bool ignore_depth false
float32 depth_override_value
float32 forward_tolerance
float32 sidemove_tolerance
float32 heading_tolerance
float32 depth_tolerance
int32 stabilize_duration
---
# Result
uint8 STATUS_SUCCESS = 0
uint8 STATUS_FAILURE = 1
uint8 STATUS_ABORTED = 2
uint8 status
---
# Feedback
float32 percentage_complete
float32 distance_remaining
