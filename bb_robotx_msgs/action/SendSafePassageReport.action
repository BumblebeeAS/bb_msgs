# Send a SafePassageReport to RoboCommand through the OCS (ocs4_gui bridge), on /<vehicle>/report/safe_passage.
# Succeeds once RoboCommand's broker has it (RoboCommand itself never replies); aborts with error otherwise.
SafePassageReport report
---
uint32 seq      # RxReport seq, when sent
string error    # why it was not sent
---
string status   # progress, e.g. "sent to OCS"
