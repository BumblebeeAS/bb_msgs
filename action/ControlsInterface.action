uint8 MODE_DEPTH = 0
uint8 MODE_2D = 1
uint8 MODE_3D = 2

nav_msgs/Path   path
uint8   mode                # 0: depth, 1: 2d (x, y, yaw), 2: 3d (x, y, z, roll, pitch, yaw)
uint8 yaw_mode              # 0: target_yaw (default): uses target_frame_position and 
                            # 1: uses target_frame position and direction of approach as reference frame.
                            # 2: uses target_frame position and starting vehicle yaw as reference frame.
                            # 3: uses target_frame position and world_ned (if pose is in ned) yaw as reference frame.
bool face_target            # if true, final yaw will be calculated to face target origin.
bool use_collision_avoidance false

---
bool success
---
float32 yaw_error                   # degrees
float32 depth_error
float32 forward_error
float32 sidemove_error
float32 overall_progress             # 0 to 1 for trajectory progress
