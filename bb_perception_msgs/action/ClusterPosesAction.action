# Request
ClusterPosesRequest params
float64 collection_duration 5.0  # Duration in seconds to collect synchronized messages
# Optional periodic cluster snapshots in feedback; 0 evaluates only at completion.
# One goal owns a fresh, bounded collection until completion or cancellation.
float64 cluster_interval 0.0

---
# Result
ClusterPoseResultArray cluster_results
---
# Feedback
float64 collection_progress  # 0.0 to 1.0
int32 poses_collected_so_far
string current_status
ClusterPoseResultArray cluster_results  # Latest snapshot; empty between evaluations
