# Request
ClusterPosesRequest params
float64 collection_duration 5.0  # Maximum collection duration in monotonic seconds
# Seconds between cluster evaluations; must be greater than zero.
# Each evaluation clusters this goal's accumulated poses and sends the clusters
# in feedback. Poses keep accumulating until collection_duration expires or
# the goal is canceled; evaluations do not reset collection.
float64 cluster_interval 2.0

---
# Result
ClusterPoseResultArray cluster_results
---
# Feedback
float64 collection_progress  # 0.0 to 1.0
int32 poses_collected_so_far
string current_status
ClusterPoseResultArray cluster_results  # Latest snapshot; empty between evaluations
